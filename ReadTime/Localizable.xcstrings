    "ReadTime follows the language chosen for it in the Settings app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ReadTime usa el idioma que elijas para ella en la app Ajustes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ReadTime は「設定」アプリで選択した言語で表示されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ReadTime dùng ngôn ngữ bạn chọn cho ứng dụng trong app Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ReadTime 使用你在“设置” App 中为其选择的语言。"
          }
        }
      }
    },
    "ReadTime helps you build a gentle reading habit with daily goals, timed reading sessions, a reading journal, and simple stats." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ReadTime te ayuda a crear un hábito de lectura con objetivos diarios, sesiones cronometradas, un diario de lectura y estadísticas sencillas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ReadTime は、毎日の目標、時間を計る読書セッション、読書日記、シンプルな統計で、無理のない読書習慣づくりをサポートします。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ReadTime giúp bạn xây dựng thói quen đọc sách nhẹ nhàng với mục tiêu hằng ngày, phiên đọc có hẹn giờ, nhật ký đọc và thống kê đơn giản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ReadTime 通过每日目标、计时阅读、阅读日记和简洁的统计，帮你轻松养成阅读习惯。"
          }
        }
      }
    },
