    "Add books to your library to see your favourite genres.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade libros a tu biblioteca para ver tus géneros favoritos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリに本を追加すると、好きなジャンルが表示されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm sách vào thư viện để xem thể loại yêu thích của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在书架中添加图书，即可查看你喜爱的类型。"
          }
        }
      }
    },
    "Add your first book": {
      "localizations": {
        "es": {
