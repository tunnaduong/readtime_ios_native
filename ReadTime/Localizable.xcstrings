    "Anything you want to remember? Keep it short and clean.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Algo que quieras recordar? Que sea breve y claro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚えておきたいことはありますか？短く簡潔に書きましょう。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có điều gì bạn muốn ghi nhớ? Hãy viết ngắn gọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有什么想记住的吗？简短清晰地写下来吧。"
          }
        }
      }
    },
