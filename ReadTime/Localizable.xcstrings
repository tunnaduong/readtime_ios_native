    "You can load or clear demo content anytime in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cargar o borrar el contenido de demostración en cualquier momento desde Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デモコンテンツはいつでも設定から読み込んだり消去したりできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể tải hoặc xóa nội dung mẫu bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你随时可以在设置中载入或清除示例内容。"
          }
        }
      }
    },
    "You have made good progress on your goals!": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Has avanzado mucho en tus objetivos!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標に向けて順調に進んでいます！"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã có tiến bộ tốt với mục tiêu của mình!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的目标进展很不错！"
          }
        }
      }
    },
    "Your book is waiting for the next chapter.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu libro te espera en el siguiente capítulo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本が次の章であなたを待っています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuốn sách của bạn đang chờ chương tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的书正等着你翻开下一章。"
          }
        }
      }
    },
    "Your books, goals, and journal on this device will be replaced with the iCloud backup.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los libros, objetivos y diario de este dispositivo se reemplazarán por la copia de iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの本、目標、日記が iCloud のバックアップで置き換えられます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sách, mục tiêu và nhật ký trên thiết bị này sẽ được thay thế bằng bản sao lưu iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的图书、目标和日记将被 iCloud 备份替换。"
          }
        }
      }
    },
    "Your purchase is pending approval.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra está pendiente de aprobación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入は承認待ちです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch mua của bạn đang chờ phê duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的购买正在等待批准。"
          }
        }
      }
    },
    "Your purchases have been restored.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han restaurado tus compras."
          }
        },
        "ja": {
