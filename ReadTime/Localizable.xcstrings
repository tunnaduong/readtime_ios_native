          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日の目標、時間を計る読書セッション、読書日記で、無理のない読書習慣をつくりましょう。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xây dựng thói quen đọc sách nhẹ nhàng với mục tiêu hằng ngày, phiên đọc có hẹn giờ và nhật ký đọc."
          }
