    "What are you reading now, or what's next on your list?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué estás leyendo ahora o qué es lo próximo en tu lista?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今読んでいる本、または次に読みたい本は？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang đọc cuốn gì, hay cuốn tiếp theo bạn muốn đọc là gì?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
