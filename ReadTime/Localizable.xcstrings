{
  "sourceLanguage": "en",
  "strings": {
    "“%@” will be removed from your library. Your reading history and journal stay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» se eliminará de tu biblioteca. Tu historial de lectura y tu diario se conservan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」がライブラリから削除されます。読書履歴と日記は残ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” sẽ bị xóa khỏi thư viện. Lịch sử đọc và nhật ký của bạn vẫn được giữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "《%@》将从书架中删除，你的阅读记录和日记会保留。"
          }
        }
      }
    },
