        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sách mẫu, hoạt động mẫu và nhật ký mẫu sẽ bị xóa. Sách và dữ liệu đọc của bạn vẫn được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
