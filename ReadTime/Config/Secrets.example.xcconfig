// Copy this file to Secrets.xcconfig (same folder) and fill in the values.
// Secrets.xcconfig is git-ignored, so keys never get committed.

// Google Books API key (optional). Without it, book search still works using the
// keyless Google quota and Open Library as a fallback.
// Create one at https://console.cloud.google.com → APIs & Services → Credentials,
// restricted to the Books API and the iOS bundle ID com.fatties.readtime.
GOOGLE_BOOKS_API_KEY =

// Optional: override the AdMob test IDs from ReadTime.xcconfig on this machine.
// ADMOB_APP_ID = ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
// ADMOB_INTERSTITIAL_UNIT_ID = ca-app-pub-xxxxxxxxxxxxxxxx/zzzzzzzzzz
// ADMOB_BANNER_UNIT_ID = ca-app-pub-xxxxxxxxxxxxxxxx/wwwwwwwwww
// ADMOB_APP_OPEN_UNIT_ID = ca-app-pub-xxxxxxxxxxxxxxxx/vvvvvvvvvv
